{
  "name": "@mnshahawy/daffa-console-ui",
  "version": "0.1.0",
  "description": "Vue 3 + Tailwind v4 component kit for Daffa-family operations consoles: status vocabulary, action grammar, tokens, and the primitives (buttons, selects, dialogs, toasts, confirm) extracted from Daffa's web console.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mnshahawy/daffa.git",
    "directory": "console-ui"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/base.css": "./styles/base.css",
    "./styles/fonts.css": "./styles/fonts.css",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*"
  },
  "files": [
    "src",
    "styles",
    "fonts",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "scripts": {
    "check": "vue-tsc --noEmit"
  }
}
